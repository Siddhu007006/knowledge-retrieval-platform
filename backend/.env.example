# Required for embeddings, query rewriting, answer generation and grounding validation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Frontend origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Chunking (approximate token count; overlap preserves context between chunks)
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Retrieval
INITIAL_RETRIEVAL_K=20
RERANK_TOP_K=5
MIN_RETRIEVAL_SCORE=0.25

# Input limits
MAX_FILE_SIZE_MB=20
MAX_QUERY_LENGTH=500

# Retrieval retry / answer grounding
GROUNDING_MAX_RETRIES=2
QUERY_REWRITE_ENABLED=true

# Conversation memory
CONVERSATION_HISTORY_LIMIT=12

# Runtime
LOG_LEVEL=INFO
STORAGE_DIR=data/storage
INDEX_DIR=data/index
CONVERSATION_DB_PATH=data/storage/conversations.sqlite3
